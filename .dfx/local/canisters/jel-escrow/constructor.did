type EscrowCanister = service {
  getAllowlist : () -> (principal) query;
  place_bet : (PlaceBetArgs) -> (Result_1);
  report_outcome : (ReportOutcomeArgs) -> (Result);
  start_game : (StartGameArgs) -> (Result);
  testLedgerConnection : () -> (text);
};
type EscrowError = variant {
  InsufficientAllowance;
  NoApproval;
  Unauthorized;
  InvalidTier;
  NoActiveGame;
  TransferFailed : text;
};
type GameOutcome = variant { draw; black; white };
type PlaceBetArgs = record {
  username : text;
  player : principal;
  wallet_address : text;
  pot_tier : nat;
  anonymous : bool;
  amount_e8s : nat;
  outcome : GameOutcome;
};
type ReportOutcomeArgs = record {
  result : GameOutcome;
  end_time : nat;
  game_id : text;
};
type Result = variant { ok; err : EscrowError };
type Result_1 = variant { ok : nat; err : EscrowError };
type StartGameArgs = record { start_time : nat; game_id : text };
service : () -> EscrowCanister