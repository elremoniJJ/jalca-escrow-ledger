type Result = 
 variant {
   err: EscrowError;
   ok: nat;
 };
type EscrowError = 
 variant {
   AlreadySettled;
   GameNotFound;
   InsufficientAllowance;
   TimeoutNotReached;
   TransferFailed: text;
   Unauthorized;
 };
service : {
  getAllowlist: () -> (principal) query;
  place_bet: (text, principal, nat) -> (Result);
  refund_timeout: (text) -> (Result);
  report_outcome: (text, principal) -> (Result);
  testLedgerConnection: () -> (text);
  test_echo: (text) -> (text);
}
